# Cliente compatible OpenAI apuntando a DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ruta local al export de OpenFoodTox 3.0 (no versionado, ~22.6 MB)
OPENFOODTOX_XLSX_PATH=data/raw/OFT3_0_export_repository.xlsx

# Almacenamiento externo (MEGA S4, API S3-compatible) para el xlsx y el
# índice de Chroma en el deploy real -- ver efsa_rag/deploy_assets.py.
# Solo hacen falta en local si quieres forzar una re-descarga (o para
# scripts/upload_deploy_assets.py, que sí las necesita siempre); si
# data/raw/*.xlsx y data/chroma/ ya están en tu disco, el resto del
# proyecto nunca las lee. En Streamlit Community Cloud, estas mismas
# claves van pegadas en el campo "Secrets" del deploy (Advanced
# settings) -- ver README.md.
MEGA_S4_ENDPOINT_URL=
MEGA_S4_BUCKET=
MEGA_S4_ACCESS_KEY_ID=
MEGA_S4_SECRET_ACCESS_KEY=
MEGA_S4_REGION=
